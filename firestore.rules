rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Leitura pública (dashboard), escrita apenas via Admin SDK (worker).
    match /clans/{clanId} {
      allow read: if true;
      allow write: if false;
    }
    match /clans/{clanId}/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
